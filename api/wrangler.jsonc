{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zimam",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zimam",
      "database_id": "b2621fc5-378f-4871-9b25-f96ca2d9d198",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sign in with Apple audiences: the app bundle id and the web Services ID.
    "APPLE_AUDIENCES": "app.zimam.ios,app.zimam.ios.web",
    // Signs the Sign in with Apple client secret, to keep and later revoke Apple's
    // refresh token. The key is secret: `npx wrangler secret put APPLE_KEY_ID` and
    // `npx wrangler secret put APPLE_PRIVATE_KEY`. Never put them here.
    "APPLE_TEAM_ID": "72V86SZ2XC",
    // Sign in with Google: the OAuth client IDs (iOS app, then web) whose ID tokens are
    // accepted. Client IDs are public, not secrets. Empty turns Google sign-in off.
    "GOOGLE_CLIENT_IDS": "404741015373-r3p4od9ko0qd99hocpg3r7gv1arju4ge.apps.googleusercontent.com,404741015373-ukucah8482ofiuvd9lb4cn4pgqvnfm75.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "https://zimam.app,https://zimam-web.fahad2ao.workers.dev",
    // In-app assistant. Keys are secrets: `npx wrangler secret put DEEPSEEK_API_KEY`
    // (or ANTHROPIC_API_KEY with AI_PROVIDER "anthropic"; AI_GATEWAY_TOKEN when used). Never put them here.
    "AI_PROVIDER": "deepseek",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/302d00b357e2c90ed474d13642708b30/zimam",
    "AI_MONTHLY_LIMIT": "300",
    // Reminder pushes over APNs. The key is a secret: `npx wrangler secret put APNS_KEY_ID`
    // and `npx wrangler secret put APNS_PRIVATE_KEY`. Never put them here.
    "APNS_TEAM_ID": "72V86SZ2XC"
  },
  // Pushes the reminders beyond the app's local notification window (src/push/reminders.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Realtime sync: one UserChannel per user holds their WebSockets (src/realtime/channel.ts).
  "durable_objects": {
    "bindings": [{ "name": "USER_CHANNEL", "class_name": "UserChannel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserChannel"] }],
  // Imports from other apps (src/imports/). The queues and the bucket must exist before
  // deploying: see docs/setup.md, «الاستيراد».
  "queues": {
    "producers": [{ "binding": "IMPORTS", "queue": "zimam-imports" }],
    "consumers": [
      {
        "queue": "zimam-imports",
        // One chunk of one job per invocation keeps D1 queries well under the limit.
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // Keep in step with MAX_RETRIES in src/imports/jobs.ts.
        "max_retries": 3,
        "dead_letter_queue": "zimam-imports-dlq"
      },
      { "queue": "zimam-imports-dlq", "max_batch_size": 10, "max_retries": 3 }
    ]
  },
  "r2_buckets": [{ "binding": "IMPORT_FILES", "bucket_name": "zimam-imports" }]
}
