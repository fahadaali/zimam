{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zimam",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zimam",
      "database_id": "b2621fc5-378f-4871-9b25-f96ca2d9d198",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sign in with Apple audiences: the app bundle id and the web Services ID.
    "APPLE_AUDIENCES": "app.zimam.Zimam,app.zimam.web",
    "ALLOWED_ORIGINS": "https://zimam.app",
    // In-app assistant. Keys are secrets: `npx wrangler secret put ANTHROPIC_API_KEY`
    // (and DEEPSEEK_API_KEY, AI_GATEWAY_TOKEN when used). Never put them here.
    "AI_PROVIDER": "anthropic",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/302d00b357e2c90ed474d13642708b30/zimam",
    "AI_MONTHLY_LIMIT": "300"
  }
}
