{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zimam",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served only on the zimam.work domain, attached on deploy; workers.dev is off (docs/setup.md, «النطاق»).
  "routes": [{ "pattern": "api.zimam.work", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zimam",
      "database_id": "b2621fc5-378f-4871-9b25-f96ca2d9d198",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sign in with Apple audiences: the app bundle id and the web Services ID.
    "APPLE_AUDIENCES": "app.zimam.ios,app.zimam.ios.web",
    // Signs the Sign in with Apple client secret, to keep and later revoke Apple's
    // refresh token. The key is secret: `npx wrangler secret put APPLE_KEY_ID` and
    // `npx wrangler secret put APPLE_PRIVATE_KEY`. Never put them here.
    "APPLE_TEAM_ID": "72V86SZ2XC",
    // Web codes (Sign in with Apple JS) are exchanged with the redirect URI the page used, which the
    // client sends and must be one of these: the web app's, then the others (the MCP consent page).
    // Each must be a Return URL of the Services ID app.zimam.ios.web too.
    "APPLE_WEB_REDIRECT_URI": "https://zimam.work/app",
    "APPLE_REDIRECT_URIS": "https://mcp.zimam.work/authorize",
    // Sign in with Google: the OAuth client IDs (iOS app, then web) whose ID tokens are
    // accepted. Client IDs are public, not secrets. Empty turns Google sign-in off.
    "GOOGLE_CLIENT_IDS": "404741015373-r3p4od9ko0qd99hocpg3r7gv1arju4ge.apps.googleusercontent.com,404741015373-ukucah8482ofiuvd9lb4cn4pgqvnfm75.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "https://zimam.work",
    // In-app assistant. Keys are secrets: `npx wrangler secret put DEEPSEEK_API_KEY`
    // (or ANTHROPIC_API_KEY with AI_PROVIDER "anthropic"; AI_GATEWAY_TOKEN when used). Never put them here.
    "AI_PROVIDER": "deepseek",
    "AI_GATEWAY_URL": "https://gateway.ai.cloudflare.com/v1/302d00b357e2c90ed474d13642708b30/zimam",
    "AI_MONTHLY_LIMIT": "300",
    // Monthly assistant requests by plan (src/ai/quota.ts). Free applies only when
    // SUBSCRIPTIONS_ENFORCED is "true"; "0" keeps the assistant pro-only (403 pro_required).
    "AI_MONTHLY_LIMIT_FREE": "20",
    "AI_MONTHLY_LIMIT_PRO": "300",
    // Attachment storage per uploader, in MB, by plan (src/attachments.ts). Pro is everyone's
    // while SUBSCRIPTIONS_ENFORCED is not "true".
    "ATTACHMENT_QUOTA_MB_FREE": "1024",
    "ATTACHMENT_QUOTA_MB_PRO": "10240",
    // Reminder pushes over APNs. The key is a secret: `npx wrangler secret put APNS_KEY_ID`
    // and `npx wrangler secret put APNS_PRIVATE_KEY`. Never put them here.
    "APNS_TEAM_ID": "72V86SZ2XC",
    // «زمام الاحترافية» (src/subscriptions/). App Store transactions must be for this bundle id.
    // The In-App Purchase key is secret: `npx wrangler secret put APPSTORE_KEY_ID`,
    // `APPSTORE_ISSUER_ID` and `APPSTORE_PRIVATE_KEY`. Never put them here.
    "APPSTORE_BUNDLE_ID": "app.zimam.ios",
    // "true" makes the assistant, MCP and server imports need a subscription. "false" during
    // the personal trial: everyone uses everything, and the app shows the plan without blocking.
    "SUBSCRIPTIONS_ENFORCED": "false",
    // Comma-separated user ids or emails treated as pro whatever their subscription (the owner).
    "PRO_USERS": "",
    // Imports through OAuth (src/imports/oauth.ts). Google Calendar and Google Tasks use the web client
    // above; its secret and every other provider's credentials are secrets (docs/setup.md, «الاستيراد بإذن OAuth»):
    // GOOGLE_CLIENT_SECRET, MS_CLIENT_ID, MS_CLIENT_SECRET, NOTION_CLIENT_ID, NOTION_CLIENT_SECRET,
    // TRELLO_API_KEY, ASANA_CLIENT_ID, ASANA_CLIENT_SECRET, TICKTICK_CLIENT_ID, TICKTICK_CLIENT_SECRET,
    // TODOIST_CLIENT_ID, TODOIST_CLIENT_SECRET, CLICKUP_CLIENT_ID, CLICKUP_CLIENT_SECRET, JIRA_CLIENT_ID,
    // JIRA_CLIENT_SECRET, LINEAR_CLIENT_ID, LINEAR_CLIENT_SECRET, MONDAY_CLIENT_ID, MONDAY_CLIENT_SECRET.
    // Microsoft Planner uses Microsoft To Do's MS_CLIENT_ID and MS_CLIENT_SECRET.
    // A source without its secrets is listed as unavailable. Never put them here.
    "GOOGLE_WEB_CLIENT_ID": "404741015373-ukucah8482ofiuvd9lb4cn4pgqvnfm75.apps.googleusercontent.com"
  },
  // Pushes the reminders beyond the app's local notification window (src/push/reminders.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Realtime sync: one UserChannel per user holds their WebSockets (src/realtime/channel.ts).
  "durable_objects": {
    "bindings": [{ "name": "USER_CHANNEL", "class_name": "UserChannel" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserChannel"] }],
  // Imports from other apps (src/imports/). The queues and the bucket must exist before
  // deploying: see docs/setup.md, «الاستيراد».
  "queues": {
    "producers": [{ "binding": "IMPORTS", "queue": "zimam-imports" }],
    "consumers": [
      {
        "queue": "zimam-imports",
        // One chunk of one job per invocation keeps D1 queries well under the limit.
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        // Keep in step with MAX_RETRIES in src/imports/jobs.ts.
        "max_retries": 3,
        "dead_letter_queue": "zimam-imports-dlq"
      },
      { "queue": "zimam-imports-dlq", "max_batch_size": 10, "max_retries": 3 }
    ]
  },
  // Task attachments (src/attachments.ts). The bucket must exist before deploying, or the deploy
  // fails: `npx wrangler r2 bucket create zimam-attachments` (docs/setup.md, «المرفقات»).
  "r2_buckets": [
    { "binding": "IMPORT_FILES", "bucket_name": "zimam-imports" },
    { "binding": "ATTACHMENTS", "bucket_name": "zimam-attachments" }
  ]
}
