{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zimam-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Lets the OAuth provider fetch Client ID Metadata Documents without reaching private addresses.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      // OAuth clients, grants and tokens (stored hashed). Create with: npx wrangler kv namespace create zimam-oauth
      "binding": "OAUTH_KV",
      "id": "b74ed41be5be43c4aa567d1c010dd4df"
    }
  ],
  // Tasks are read and written through the API worker's RPC entrypoint, never over the internet.
  "services": [{ "binding": "API", "service": "zimam", "entrypoint": "ZimamService" }],
  // Logos, tokens.css and the web fonts for the consent page.
  "assets": { "directory": "../design" },
  "vars": {
    "MCP_ORIGIN": "https://zimam-mcp.fahad2ao.workers.dev",
    // Sign in with Apple Services ID for the web.
    "APPLE_WEB_CLIENT_ID": "app.zimam.ios.web",
    // Google OAuth web client ID (public, not a secret); must be in the API's GOOGLE_CLIENT_IDS.
    // Empty hides «المتابعة بحساب قوقل» on the consent page.
    "GOOGLE_WEB_CLIENT_ID": "404741015373-ukucah8482ofiuvd9lb4cn4pgqvnfm75.apps.googleusercontent.com"
  }
}
