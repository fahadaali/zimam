{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only, no Worker script. Run `npm run build` first: it copies design/ into public/design/.
  "name": "zimam-web",
  "compatibility_date": "2026-10-01",
  // Served only on the zimam.work domain, attached on deploy; workers.dev is off (docs/setup.md, «النطاق»).
  "routes": [{ "pattern": "zimam.work", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    // /app/ is one page that switches views by the URL hash, so no SPA fallback is needed.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
